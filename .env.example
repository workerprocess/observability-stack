GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# App services should send telemetry to these endpoints:
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=my-service
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,service.namespace=scc

# Keycloak OAuth settings for Grafana:
KEYCLOAK_OAUTH_CLIENT_SECRET=your_client_secret_here
KEYCLOAK_OAUTH_BASE_URL=https://your-keycloak-domain/realms/your-realm
