{
  "title": "Core Telemetry Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "OTel Collector Metrics",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [{"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "{__name__=~\"core_.*\"}", "refId": "A"}]
    },
    {
      "type": "logs",
      "title": "Recent Logs",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [{"datasource": {"type": "loki", "uid": "Loki"}, "expr": "{exporter=\"OTLP\"}", "refId": "A"}]
    }
  ]
}
